{
  "manifest_version": 3,
  "name": "Aria2NET",
  "version": "0.8.0",
  "description": "Sends browser downloads to the Aria2NET download manager.",
  "key": "",
  "minimum_chrome_version": "110",
  "permissions": ["downloads", "nativeMessaging", "cookies", "storage", "contextMenus"],
  "host_permissions": ["<all_urls>"],
  "background": { "service_worker": "background.js" },
  "action": { "default_title": "Aria2NET", "default_popup": "options.html" },
  "options_ui": { "page": "options.html", "open_in_tab": false }
}
