<?xml version="1.0" encoding="utf-8"?>
<UserControl
    x:Class="Aria2NET.Controls.DownloadDetailPane"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:vm="using:Aria2NET.ViewModels">

    <UserControl.Resources>
        <Style x:Key="DetailLabel" TargetType="TextBlock">
            <Setter Property="Opacity" Value="0.7" />
        </Style>
        <Style x:Key="DenseItem" TargetType="ListViewItem" BasedOn="{StaticResource DefaultListViewItemStyle}">
            <Setter Property="HorizontalContentAlignment" Value="Stretch" />
            <Setter Property="MinHeight" Value="30" />
        </Style>
    </UserControl.Resources>

    <Grid Padding="12,2,12,8" RowSpacing="4" CornerRadius="8" BorderThickness="1"
          Background="{ThemeResource CardBackgroundFillColorDefaultBrush}" BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <Grid ColumnSpacing="12">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>
            <SelectorBar x:Name="Tabs" SelectionChanged="Tabs_SelectionChanged">
                <SelectorBarItem x:Uid="DetailPane_TabGeneral" x:Name="GeneralTab" Tag="General" Text="General" />
                <SelectorBarItem x:Name="FilesTab" Tag="Files" Text="{x:Bind Detail.FilesHeader, Mode=OneWay}" />
                <SelectorBarItem x:Name="PeersTab" Tag="Peers" Text="{x:Bind Detail.PeersHeader, Mode=OneWay}" />
                <SelectorBarItem x:Uid="DetailPane_TabTrackers" x:Name="TrackersTab" Tag="Trackers" Text="Trackers" />
                <SelectorBarItem x:Uid="DetailPane_TabPieces" x:Name="PiecesTab" Tag="Pieces" Text="Pieces" />
            </SelectorBar>
            <TextBlock Grid.Column="1" Text="{x:Bind Row.Name, Mode=OneWay}" VerticalAlignment="Center" HorizontalAlignment="Right" Opacity="0.7"
                       TextTrimming="CharacterEllipsis" ToolTipService.ToolTip="{x:Bind Row.Name, Mode=OneWay}" />
            <Button x:Uid="DetailPane_CloseButton" Grid.Column="2" VerticalAlignment="Center" Padding="8" Background="Transparent" BorderThickness="0" Click="Close_Click"
                    ToolTipService.ToolTip="Hide details" AutomationProperties.Name="Hide details">
                <FontIcon Glyph="&#xE8BB;" FontSize="10" />
            </Button>
        </Grid>

        <TextBlock x:Name="ProblemText" Grid.Row="1" Text="{x:Bind Detail.Problem, Mode=OneWay}" Visibility="Collapsed"
                   Foreground="{ThemeResource SystemFillColorCautionBrush}" TextWrapping="Wrap" />

        <ScrollViewer x:Name="GeneralPanel" Grid.Row="2" VerticalScrollBarVisibility="Auto">
            <StackPanel Spacing="6" Margin="0,4,12,0">
                <ProgressBar Minimum="0" Maximum="100" Value="{x:Bind Row.Progress, Mode=OneWay}" Foreground="{x:Bind Row.ProgressBrush, Mode=OneWay}"
                             IsIndeterminate="{x:Bind Row.IsIndeterminate, Mode=OneWay}" Margin="0,0,0,2" />
                <Grid ColumnSpacing="16">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="100" /><ColumnDefinition Width="*" /><ColumnDefinition Width="100" /><ColumnDefinition Width="*" />
                    </Grid.ColumnDefinitions>
                    <TextBlock x:Uid="DetailPane_LabelStatus" Style="{StaticResource DetailLabel}" Text="Status"/>
                    <TextBlock Grid.Column="1" Text="{x:Bind Row.StatusText, Mode=OneWay}" />
                    <TextBlock x:Uid="DetailPane_LabelDownloaded" Grid.Column="2" Style="{StaticResource DetailLabel}" Text="Downloaded"/>
                    <TextBlock Grid.Column="3" Text="{x:Bind Detail.Downloaded, Mode=OneWay}" IsTextSelectionEnabled="True" />
                </Grid>
                <Grid ColumnSpacing="16">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="100" /><ColumnDefinition Width="*" /><ColumnDefinition Width="100" /><ColumnDefinition Width="*" />
                    </Grid.ColumnDefinitions>
                    <TextBlock x:Uid="DetailPane_LabelSpeed" Style="{StaticResource DetailLabel}" Text="Speed"/>
                    <TextBlock Grid.Column="1" Text="{x:Bind Detail.Speed, Mode=OneWay}" />
                    <TextBlock x:Uid="DetailPane_LabelEta" Grid.Column="2" Style="{StaticResource DetailLabel}" Text="Time left"/>
                    <TextBlock Grid.Column="3" Text="{x:Bind Row.EtaText, Mode=OneWay}" />
                </Grid>
                <Grid ColumnSpacing="16">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="100" /><ColumnDefinition Width="*" /><ColumnDefinition Width="100" /><ColumnDefinition Width="*" />
                    </Grid.ColumnDefinitions>
                    <TextBlock x:Uid="DetailPane_LabelConnections" Style="{StaticResource DetailLabel}" Text="Connections"/>
                    <TextBlock Grid.Column="1" Text="{x:Bind Detail.Connections, Mode=OneWay}" />
                    <TextBlock x:Uid="DetailPane_LabelUploaded" x:Name="UploadedLabel" Grid.Column="2" Style="{StaticResource DetailLabel}" Text="Uploaded"/>
                    <TextBlock x:Name="UploadedValue" Grid.Column="3" Text="{x:Bind Detail.Uploaded, Mode=OneWay}" />
                </Grid>
                <Grid x:Name="ErrorLine" ColumnSpacing="16" Visibility="Collapsed">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="100" /><ColumnDefinition Width="*" />
                    </Grid.ColumnDefinitions>
                    <TextBlock x:Uid="DetailPane_LabelError" Style="{StaticResource DetailLabel}" Text="Problem"/>
                    <TextBlock Grid.Column="1" Text="{x:Bind Row.StatusTip, Mode=OneWay}" TextWrapping="Wrap" IsTextSelectionEnabled="True" />
                </Grid>
                <Grid ColumnSpacing="16">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="100" /><ColumnDefinition Width="*" />
                    </Grid.ColumnDefinitions>
                    <TextBlock x:Uid="DetailPane_LabelSavedTo" Style="{StaticResource DetailLabel}" Text="Saved to"/>
                    <TextBlock Grid.Column="1" Text="{x:Bind Detail.SavedTo, Mode=OneWay}" TextWrapping="Wrap" IsTextSelectionEnabled="True" />
                </Grid>
                <Grid x:Name="SourceLine" ColumnSpacing="16">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="100" /><ColumnDefinition Width="*" />
                    </Grid.ColumnDefinitions>
                    <TextBlock x:Uid="DetailPane_LabelSource" Style="{StaticResource DetailLabel}" Text="Source"/>
                    <TextBlock Grid.Column="1" Text="{x:Bind Detail.Source, Mode=OneWay}" TextWrapping="Wrap" IsTextSelectionEnabled="True" />
                </Grid>
                <StackPanel x:Name="TorrentLines" Spacing="6">
                    <Grid ColumnSpacing="16">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="100" /><ColumnDefinition Width="*" />
                        </Grid.ColumnDefinitions>
                        <TextBlock x:Uid="DetailPane_LabelInfoHash" Style="{StaticResource DetailLabel}" Text="Info hash"/>
                        <TextBlock Grid.Column="1" Text="{x:Bind Detail.InfoHash, Mode=OneWay}" IsTextSelectionEnabled="True" FontFamily="Consolas" />
                    </Grid>
                    <Grid ColumnSpacing="16">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="100" /><ColumnDefinition Width="*" /><ColumnDefinition Width="100" /><ColumnDefinition Width="*" />
                        </Grid.ColumnDefinitions>
                        <TextBlock x:Uid="DetailPane_LabelPieces" Style="{StaticResource DetailLabel}" Text="Pieces"/>
                        <TextBlock Grid.Column="1" Text="{x:Bind Detail.PieceInfo, Mode=OneWay}" />
                        <TextBlock x:Uid="DetailPane_LabelCreated" Grid.Column="2" Style="{StaticResource DetailLabel}" Text="Created"/>
                        <TextBlock Grid.Column="3" Text="{x:Bind Detail.Created, Mode=OneWay}" />
                    </Grid>
                    <Grid ColumnSpacing="16">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="100" /><ColumnDefinition Width="*" />
                        </Grid.ColumnDefinitions>
                        <TextBlock x:Uid="DetailPane_LabelComment" Style="{StaticResource DetailLabel}" Text="Comment"/>
                        <TextBlock Grid.Column="1" Text="{x:Bind Detail.Comment, Mode=OneWay}" TextWrapping="Wrap" IsTextSelectionEnabled="True" />
                    </Grid>
                </StackPanel>
            </StackPanel>
        </ScrollViewer>

        <Grid x:Name="FilesPanel" Grid.Row="2" RowSpacing="2" Visibility="Collapsed">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="*" />
            </Grid.RowDefinitions>
            <Grid x:Name="FilesTools" ColumnSpacing="8" Visibility="Collapsed">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto" /><ColumnDefinition Width="*" />
                </Grid.ColumnDefinitions>
                <Button x:Uid="DetailPane_FilesSelectAll" x:Name="SelectAllButton" Content="Select all" Padding="10,3" Click="SelectAll_Click" />
                <TextBlock x:Uid="DetailPane_FilesHint" Grid.Column="1" VerticalAlignment="Center" Opacity="0.7" TextTrimming="CharacterEllipsis"
                           Text="Untick a file to leave it out. Right-click a file for more."/>
            </Grid>
            <Grid Grid.Row="1" ColumnSpacing="12" Padding="16,0,28,0">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="24" /><ColumnDefinition Width="*" /><ColumnDefinition Width="160" /><ColumnDefinition Width="64" /><ColumnDefinition Width="90" />
                </Grid.ColumnDefinitions>
                <TextBlock x:Uid="DetailPane_FileName" Grid.Column="1" Style="{StaticResource DetailLabel}" Text="Name"/>
                <TextBlock x:Uid="DetailPane_FileProgress" Grid.Column="2" Style="{StaticResource DetailLabel}" Text="Progress"/>
                <TextBlock x:Uid="DetailPane_FileSize" Grid.Column="4" Style="{StaticResource DetailLabel}" Text="Size" HorizontalAlignment="Right"/>
            </Grid>
            <ListView x:Name="FileList" Grid.Row="2" ItemsSource="{x:Bind Detail.Files, Mode=OneWay}" SelectionMode="None" ItemContainerStyle="{StaticResource DenseItem}"
                      ContainerContentChanging="DetailList_ContainerContentChanging" RightTapped="FileList_RightTapped">
                <ListView.ItemTemplate>
                    <DataTemplate x:DataType="vm:DetailFileRow">
                        <Grid ColumnSpacing="12">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="24" /><ColumnDefinition Width="*" /><ColumnDefinition Width="160" /><ColumnDefinition Width="64" /><ColumnDefinition Width="90" />
                            </Grid.ColumnDefinitions>
                            <CheckBox MinWidth="0" Padding="0" VerticalAlignment="Center" IsChecked="{x:Bind Selected, Mode=TwoWay}" IsEnabled="{x:Bind CanChoose, Mode=OneWay}"
                                      Visibility="{x:Bind ShowChoice, Mode=OneWay}" Click="FileCheck_Click" AutomationProperties.Name="{x:Bind Path}" />
                            <TextBlock Grid.Column="1" Text="{x:Bind Path}" VerticalAlignment="Center" TextTrimming="CharacterEllipsis" ToolTipService.ToolTip="{x:Bind Path}" />
                            <ProgressBar Grid.Column="2" Minimum="0" Maximum="100" Value="{x:Bind Progress, Mode=OneWay}" VerticalAlignment="Center" />
                            <TextBlock Grid.Column="3" Text="{x:Bind Done, Mode=OneWay}" VerticalAlignment="Center" HorizontalAlignment="Right" />
                            <TextBlock Grid.Column="4" Text="{x:Bind Size, Mode=OneWay}" VerticalAlignment="Center" HorizontalAlignment="Right" />
                        </Grid>
                    </DataTemplate>
                </ListView.ItemTemplate>
            </ListView>
        </Grid>

        <Grid x:Name="PeersPanel" Grid.Row="2" RowSpacing="2" Visibility="Collapsed">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="*" />
            </Grid.RowDefinitions>
            <Grid ColumnSpacing="8" Padding="16,0,28,0">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="190" /><ColumnDefinition Width="*" /><ColumnDefinition Width="60" />
                    <ColumnDefinition Width="90" /><ColumnDefinition Width="90" /><ColumnDefinition Width="60" /><ColumnDefinition Width="110" />
                </Grid.ColumnDefinitions>
                <TextBlock x:Uid="DetailPane_PeerAddress" Style="{StaticResource DetailLabel}" Text="Address"/>
                <TextBlock x:Uid="DetailPane_PeerClient" Grid.Column="1" Style="{StaticResource DetailLabel}" Text="Client"/>
                <TextBlock x:Uid="DetailPane_PeerCountry" Grid.Column="2" Style="{StaticResource DetailLabel}" Text="Country"/>
                <TextBlock x:Uid="DetailPane_PeerDown" Grid.Column="3" Style="{StaticResource DetailLabel}" Text="Down" HorizontalAlignment="Right"/>
                <TextBlock x:Uid="DetailPane_PeerUp" Grid.Column="4" Style="{StaticResource DetailLabel}" Text="Up" HorizontalAlignment="Right"/>
                <TextBlock x:Uid="DetailPane_PeerHas" Grid.Column="5" Style="{StaticResource DetailLabel}" Text="Has" HorizontalAlignment="Right"/>
                <TextBlock x:Uid="DetailPane_PeerFlags" Grid.Column="6" Style="{StaticResource DetailLabel}" Text="Flags"/>
            </Grid>
            <ListView Grid.Row="1" ItemsSource="{x:Bind Detail.Peers, Mode=OneWay}" SelectionMode="None" ItemContainerStyle="{StaticResource DenseItem}"
                      ContainerContentChanging="DetailList_ContainerContentChanging">
                <ListView.ItemTemplate>
                    <DataTemplate x:DataType="vm:DetailPeerRow">
                        <Grid ColumnSpacing="8">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="190" /><ColumnDefinition Width="*" /><ColumnDefinition Width="60" />
                                <ColumnDefinition Width="90" /><ColumnDefinition Width="90" /><ColumnDefinition Width="60" /><ColumnDefinition Width="110" />
                            </Grid.ColumnDefinitions>
                            <TextBlock Text="{x:Bind Address}" VerticalAlignment="Center" IsTextSelectionEnabled="True" />
                            <TextBlock Grid.Column="1" Text="{x:Bind Client}" VerticalAlignment="Center" TextTrimming="CharacterEllipsis" />
                            <TextBlock Grid.Column="2" Text="{x:Bind Country}" VerticalAlignment="Center" ToolTipService.ToolTip="{x:Bind CountryTip}" />
                            <TextBlock Grid.Column="3" Text="{x:Bind Down}" VerticalAlignment="Center" HorizontalAlignment="Right" />
                            <TextBlock Grid.Column="4" Text="{x:Bind Up}" VerticalAlignment="Center" HorizontalAlignment="Right" />
                            <TextBlock Grid.Column="5" Text="{x:Bind Progress}" VerticalAlignment="Center" HorizontalAlignment="Right" />
                            <TextBlock Grid.Column="6" Text="{x:Bind Flags}" VerticalAlignment="Center" Opacity="0.8" />
                        </Grid>
                    </DataTemplate>
                </ListView.ItemTemplate>
            </ListView>
        </Grid>

        <Grid x:Name="TrackersPanel" Grid.Row="2" RowSpacing="6" Visibility="Collapsed">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="*" />
            </Grid.RowDefinitions>
            <TextBlock x:Uid="DetailPane_TrackerNote" Opacity="0.7" TextWrapping="Wrap"
                       Text="aria2 does not report tracker status and cannot change the trackers of a torrent that is already added. Public trackers from the cached list are added when a torrent is first added."/>
            <ListView Grid.Row="1" ItemsSource="{x:Bind Detail.Trackers, Mode=OneWay}" SelectionMode="None" ItemContainerStyle="{StaticResource DenseItem}"
                      ContainerContentChanging="DetailList_ContainerContentChanging">
                <ListView.ItemTemplate>
                    <DataTemplate x:DataType="vm:DetailTrackerRow">
                        <Grid ColumnSpacing="12">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="60" />
                            </Grid.ColumnDefinitions>
                            <TextBlock Text="{x:Bind Url}" VerticalAlignment="Center" IsTextSelectionEnabled="True" TextTrimming="CharacterEllipsis" />
                            <TextBlock Grid.Column="1" Text="{x:Bind Tier}" VerticalAlignment="Center" Opacity="0.7" />
                        </Grid>
                    </DataTemplate>
                </ListView.ItemTemplate>
            </ListView>
        </Grid>

        <ScrollViewer x:Name="PiecesPanel" Grid.Row="2" VerticalScrollBarVisibility="Auto" Visibility="Collapsed">
            <StackPanel Spacing="6" Margin="0,4,12,0">
                <TextBlock x:Uid="DetailPane_HaveLabel" Text="What you have" Style="{StaticResource BodyStrongTextBlockStyle}"/>
                <Rectangle x:Uid="DetailPane_HaveBar" Height="22" RadiusX="3" RadiusY="3" Fill="{x:Bind Detail.HaveBrush, Mode=OneWay}"
                           AutomationProperties.Name="Pieces downloaded"/>
                <TextBlock x:Uid="DetailPane_AvailabilityLabel" Text="Where it can be had (connected peers)" Style="{StaticResource BodyStrongTextBlockStyle}" Margin="0,8,0,0"/>
                <Rectangle x:Uid="DetailPane_AvailabilityBar" Height="22" RadiusX="3" RadiusY="3" Fill="{x:Bind Detail.AvailabilityBrush, Mode=OneWay}"
                           AutomationProperties.Name="Piece availability among connected peers"/>
                <TextBlock x:Uid="DetailPane_Legend" Opacity="0.7" TextWrapping="Wrap" Margin="0,4,0,0"
                           Text="Green: downloaded. Teal: how many of the connected peers have that part (grey means none of them). Each slice is a share of the whole torrent."/>
            </StackPanel>
        </ScrollViewer>
    </Grid>
</UserControl>
