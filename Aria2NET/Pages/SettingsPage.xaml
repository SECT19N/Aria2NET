<?xml version="1.0" encoding="utf-8"?>
<Page
    x:Class="Aria2NET.Pages.SettingsPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

    <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
    <StackPanel Padding="24" Spacing="12">
        <TextBlock Text="Settings" Style="{StaticResource TitleTextBlockStyle}" />
        <InfoBar x:Name="RestartBar" IsOpen="False" IsClosable="False" Severity="Informational"
                 Title="Restart the engine to apply" Message="The default download folder changes when the download engine restarts. Downloads in progress resume.">
            <InfoBar.ActionButton>
                <Button Content="Restart engine" Click="RestartEngine_Click" />
            </InfoBar.ActionButton>
        </InfoBar>

        <TextBlock Text="Downloads" Style="{StaticResource BodyStrongTextBlockStyle}" Margin="0,12,0,0" />
        <CheckBox Content="Ask before deleting files (Remove and delete file)"
                  x:Name="ConfirmDeleteBox" Click="ConfirmDelete_Click" />
        <Grid ColumnSpacing="8">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>
            <TextBox x:Name="FolderBox" Header="Default download folder" PlaceholderText="Your Downloads folder" LostFocus="Folder_LostFocus" />
            <Button Grid.Column="1" Content="Browse…" VerticalAlignment="Bottom" Click="BrowseFolder_Click" />
        </Grid>
        <TextBlock x:Name="FolderStatus" Opacity="0.7" TextWrapping="Wrap" />
        <TextBlock Text="New downloads go here unless you pick another folder in the Add dialog. Changing it needs an engine restart." Opacity="0.7" TextWrapping="Wrap" />
        <StackPanel Orientation="Horizontal" Spacing="16">
            <NumberBox x:Name="ConcurrentBox" Header="Downloads at once" Minimum="1" Maximum="50" SpinButtonPlacementMode="Inline" ValueChanged="Number_Changed" />
            <NumberBox x:Name="ConnectionsBox" Header="Connections per server" Minimum="1" Maximum="16" SpinButtonPlacementMode="Inline" ValueChanged="Number_Changed" />
            <NumberBox x:Name="SplitBox" Header="Split (pieces per file)" Minimum="1" Maximum="64" SpinButtonPlacementMode="Inline" ValueChanged="Number_Changed" />
            <NumberBox x:Name="MinSplitBox" Header="Min split size (MiB)" Minimum="1" Maximum="1024" SpinButtonPlacementMode="Inline" ValueChanged="Number_Changed" />
        </StackPanel>
        <TextBlock Text="More connections can be faster but some servers refuse more than a few. Applies to new downloads." Opacity="0.7" TextWrapping="Wrap" />
        <StackPanel Orientation="Horizontal" Spacing="16">
            <NumberBox x:Name="TriesBox" Header="Retries (0 = keep trying)" Minimum="0" Maximum="100" SpinButtonPlacementMode="Inline" ValueChanged="Number_Changed" />
            <NumberBox x:Name="RetryWaitBox" Header="Wait between tries (s)" Minimum="0" Maximum="600" SpinButtonPlacementMode="Inline" ValueChanged="Number_Changed" />
            <NumberBox x:Name="ConnectTimeoutBox" Header="Connect timeout (s)" Minimum="1" Maximum="600" SpinButtonPlacementMode="Inline" ValueChanged="Number_Changed" />
            <NumberBox x:Name="TimeoutBox" Header="Timeout (s)" Minimum="1" Maximum="600" SpinButtonPlacementMode="Inline" ValueChanged="Number_Changed" />
        </StackPanel>
        <StackPanel Orientation="Horizontal" Spacing="8">
            <ComboBox x:Name="UserAgentBox" Header="User agent" MinWidth="160" SelectionChanged="UserAgent_Changed" />
            <TextBox x:Name="UserAgentText" Header="Custom user agent" MinWidth="320" Visibility="Collapsed" LostFocus="UserAgentText_LostFocus" />
        </StackPanel>
        <ComboBox x:Name="AllocationBox" Header="File allocation" MinWidth="160" SelectionChanged="Allocation_Changed" />
        <TextBlock Text="None grows files as data arrives (fast to start). Prealloc and Falloc reserve the full size first; Falloc is slow for big files unless Windows lets the app skip zero-filling." Opacity="0.7" TextWrapping="Wrap" />
        <Button Content="Reset download settings to defaults" Click="ResetDownloads_Click" />

        <TextBlock Text="Speed" Style="{StaticResource BodyStrongTextBlockStyle}" Margin="0,12,0,0" />
        <StackPanel Orientation="Horizontal" Spacing="16">
            <NumberBox x:Name="DownLimitBox" Header="Download limit (KiB/s)" Minimum="0" Maximum="10000000" SpinButtonPlacementMode="Inline" SmallChange="100" LargeChange="1000" ValueChanged="Number_Changed" />
            <NumberBox x:Name="UpLimitBox" Header="Upload limit (KiB/s)" Minimum="0" Maximum="10000000" SpinButtonPlacementMode="Inline" SmallChange="100" LargeChange="1000" ValueChanged="Number_Changed" />
        </StackPanel>
        <TextBlock Text="Alternative speeds" Style="{StaticResource BodyStrongTextBlockStyle}" />
        <StackPanel Orientation="Horizontal" Spacing="16">
            <NumberBox x:Name="AltDownLimitBox" Header="Alt download limit (KiB/s)" Minimum="0" Maximum="10000000" SpinButtonPlacementMode="Inline" SmallChange="100" LargeChange="1000" ValueChanged="Number_Changed" />
            <NumberBox x:Name="AltUpLimitBox" Header="Alt upload limit (KiB/s)" Minimum="0" Maximum="10000000" SpinButtonPlacementMode="Inline" SmallChange="100" LargeChange="1000" ValueChanged="Number_Changed" />
        </StackPanel>
        <ToggleSwitch x:Name="AltSpeedSwitch" Header="Use alternative speeds" Toggled="AltSpeed_Toggled" />
        <TextBlock Text="0 means no limit. Flip alternative speeds from the Downloads toolbar to throttle quickly (say, during a video call) and back." Opacity="0.7" TextWrapping="Wrap" />
        <Button Content="Reset speed settings to defaults" Click="ResetSpeed_Click" />

        <TextBlock Text="Background" Style="{StaticResource BodyStrongTextBlockStyle}" Margin="0,12,0,0" />
        <CheckBox x:Name="CloseToTrayBox" Content="Closing the window keeps Aria2NET running in the tray" Click="CloseToTray_Click" />
        <CheckBox x:Name="MinimizeToTrayBox" Content="Minimizing the window hides it to the tray" Click="MinimizeToTray_Click" />
        <CheckBox x:Name="ConfirmExitBox" Content="Ask before exiting while downloads are running" Click="ConfirmExit_Click" />
        <CheckBox x:Name="StartWithWindowsBox" Content="Start Aria2NET when I sign in to Windows" Click="StartWithWindows_Click" />
        <CheckBox x:Name="StartMinimizedBox" Content="Start in the tray, without opening the window" Margin="28,0,0,0" Click="StartMinimized_Click" />
        <CheckBox x:Name="StartPausedBox" Content="Start with all downloads paused" Click="StartPaused_Click" />

        <TextBlock Text="Power" Style="{StaticResource BodyStrongTextBlockStyle}" Margin="0,12,0,0" />
        <CheckBox x:Name="PreventSleepBox" Content="Keep Windows awake while downloading" Click="PreventSleep_Click" />
        <CheckBox x:Name="PauseBatteryBox" Content="Pause downloads while on battery power" Click="PauseBattery_Click" />
        <CheckBox x:Name="PauseMeteredBox" Content="Pause downloads on a metered connection" Click="PauseMetered_Click" />
        <StackPanel Orientation="Horizontal" Spacing="8">
            <TextBlock Text="When downloads finish" VerticalAlignment="Center" />
            <ComboBox x:Name="FinishBox" MinWidth="160" SelectionChanged="Finish_Changed" AutomationProperties.Name="When downloads finish" />
        </StackPanel>
        <TextBlock Text="Applies once, for this run only, and then resets. Also in the tray menu." Opacity="0.7" TextWrapping="Wrap" />

        <TextBlock Text="Shortcuts and recovery" Style="{StaticResource BodyStrongTextBlockStyle}" Margin="0,12,0,0" />
        <CheckBox x:Name="HotkeysBox" Content="Global hotkeys: Ctrl+Alt+A shows or hides the window, Ctrl+Alt+N adds a download" Click="Hotkeys_Click" />
        <TextBlock x:Name="HotkeysStatus" Opacity="0.7" TextWrapping="Wrap" />
        <CheckBox x:Name="RestartBox" Content="Start again in the tray if Aria2NET crashes or stops responding" Click="Restart_Click" />

        <TextBlock Text="Notifications" Style="{StaticResource BodyStrongTextBlockStyle}" Margin="0,12,0,0" />
        <CheckBox x:Name="NotifyCompleteBox" Content="When a download completes" Click="NotifyComplete_Click" />
        <CheckBox x:Name="NotifyFailedBox" Content="When a download fails" Click="NotifyFailed_Click" />
        <CheckBox x:Name="NotifyTorrentBox" Content="When a torrent has finished downloading" Click="NotifyTorrent_Click" />
        <CheckBox x:Name="NotifySoundBox" Content="Play a sound" Click="NotifySound_Click" />
        <CheckBox x:Name="NotifyUnfocusedBox" Content="Only when the Aria2NET window is not in front" Click="NotifyUnfocused_Click" />
        <TextBlock Text="Windows holds notifications back while Focus assist (Do not disturb) is on." Opacity="0.7" TextWrapping="Wrap" />

        <TextBlock Text="Torrents" Style="{StaticResource BodyStrongTextBlockStyle}" Margin="0,12,0,0" />
        <CheckBox x:Name="AssociationBox" Content="Open .torrent files and magnet links with Aria2NET" Click="Association_Click" />
        <TextBlock x:Name="AssociationStatus" Opacity="0.7" TextWrapping="Wrap" />
        <HyperlinkButton x:Name="DefaultAppsLink" Content="Choose Aria2NET in Windows default apps…" Click="DefaultApps_Click" Visibility="Collapsed" Padding="0" />
        <StackPanel Orientation="Horizontal" Spacing="8">
            <Button Content="Update public tracker list" Click="UpdateTrackers_Click" />
            <TextBlock x:Name="TrackerStatus" VerticalAlignment="Center" Opacity="0.7" />
        </StackPanel>

        <TextBlock Text="History" Style="{StaticResource BodyStrongTextBlockStyle}" Margin="0,12,0,0" />
        <StackPanel Orientation="Horizontal" Spacing="8">
            <TextBlock Text="Keep finished downloads in History for" VerticalAlignment="Center" />
            <ComboBox x:Name="RetentionBox" MinWidth="140" SelectionChanged="Retention_Changed" AutomationProperties.Name="History retention" />
            <Button Content="Clear history…" Click="ClearHistory_Click" />
        </StackPanel>

        <TextBlock Text="Data folder" Style="{StaticResource BodyStrongTextBlockStyle}" Margin="0,12,0,0" />
        <TextBlock Text="{x:Bind ViewModel.DataFolder}" IsTextSelectionEnabled="True" />
        <StackPanel Orientation="Horizontal" Spacing="8">
            <Button Content="Open data folder" Click="OpenData_Click" />
            <Button Content="Open logs folder" Click="OpenLogs_Click" />
        </StackPanel>
    </StackPanel>
    </ScrollViewer>
</Page>
