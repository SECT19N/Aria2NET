<?xml version="1.0" encoding="utf-8"?>
<Page
    x:Class="Aria2NET.Pages.SettingsPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

    <StackPanel Padding="24" Spacing="12">
        <TextBlock Text="Settings" Style="{StaticResource TitleTextBlockStyle}" />
        <TextBlock Text="Download, speed, network and torrent settings arrive in version 0.7." Opacity="0.7" />

        <TextBlock Text="Downloads" Style="{StaticResource BodyStrongTextBlockStyle}" Margin="0,12,0,0" />
        <CheckBox Content="Ask before deleting files (Remove and delete file)"
                  x:Name="ConfirmDeleteBox" Click="ConfirmDelete_Click" />

        <TextBlock Text="Data folder" Style="{StaticResource BodyStrongTextBlockStyle}" Margin="0,12,0,0" />
        <TextBlock Text="{x:Bind ViewModel.DataFolder}" IsTextSelectionEnabled="True" />
        <StackPanel Orientation="Horizontal" Spacing="8">
            <Button Content="Open data folder" Click="OpenData_Click" />
            <Button Content="Open logs folder" Click="OpenLogs_Click" />
        </StackPanel>
    </StackPanel>
</Page>
