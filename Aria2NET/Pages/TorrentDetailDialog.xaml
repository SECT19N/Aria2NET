<?xml version="1.0" encoding="utf-8"?>
<ContentDialog
    x:Class="Aria2NET.Pages.TorrentDetailDialog"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:vm="using:Aria2NET.ViewModels"
    Title="{x:Bind ViewModel.Title, Mode=OneWay}"
    CloseButtonText="Close"
    DefaultButton="Close">

    <ContentDialog.Resources>
        <x:Double x:Key="ContentDialogMaxWidth">900</x:Double>
    </ContentDialog.Resources>

    <Grid MinWidth="760" Height="420" RowSpacing="8">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <TextBlock Text="{x:Bind ViewModel.Summary, Mode=OneWay}" Opacity="0.85" TextWrapping="Wrap" />

        <Pivot Grid.Row="1">
            <PivotItem Header="Overview">
                <ScrollViewer>
                    <Grid ColumnSpacing="16" RowSpacing="8" Margin="0,8,0,0">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="140" />
                            <ColumnDefinition Width="*" />
                        </Grid.ColumnDefinitions>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto" /><RowDefinition Height="Auto" /><RowDefinition Height="Auto" />
                            <RowDefinition Height="Auto" /><RowDefinition Height="Auto" /><RowDefinition Height="Auto" />
                            <RowDefinition Height="Auto" />
                        </Grid.RowDefinitions>
                        <TextBlock Text="Transfer" Opacity="0.7" />
                        <TextBlock Grid.Column="1" Text="{x:Bind ViewModel.Transfer, Mode=OneWay}" IsTextSelectionEnabled="True" />
                        <TextBlock Grid.Row="1" Text="Swarm" Opacity="0.7" />
                        <TextBlock Grid.Row="1" Grid.Column="1" Text="{x:Bind ViewModel.Swarm, Mode=OneWay}" IsTextSelectionEnabled="True" />
                        <TextBlock Grid.Row="2" Text="Saved to" Opacity="0.7" />
                        <TextBlock Grid.Row="2" Grid.Column="1" Text="{x:Bind ViewModel.SavedTo, Mode=OneWay}" TextWrapping="Wrap" IsTextSelectionEnabled="True" />
                        <TextBlock Grid.Row="3" Text="Info hash" Opacity="0.7" />
                        <TextBlock Grid.Row="3" Grid.Column="1" Text="{x:Bind ViewModel.InfoHash, Mode=OneWay}" IsTextSelectionEnabled="True" FontFamily="Consolas" />
                        <TextBlock Grid.Row="4" Text="Pieces" Opacity="0.7" />
                        <TextBlock Grid.Row="4" Grid.Column="1" Text="{x:Bind ViewModel.PieceInfo, Mode=OneWay}" IsTextSelectionEnabled="True" />
                        <TextBlock Grid.Row="5" Text="Created" Opacity="0.7" />
                        <TextBlock Grid.Row="5" Grid.Column="1" Text="{x:Bind ViewModel.Created, Mode=OneWay}" IsTextSelectionEnabled="True" />
                        <TextBlock Grid.Row="6" Text="Comment" Opacity="0.7" />
                        <TextBlock Grid.Row="6" Grid.Column="1" Text="{x:Bind ViewModel.Comment, Mode=OneWay}" TextWrapping="Wrap" IsTextSelectionEnabled="True" />
                    </Grid>
                </ScrollViewer>
            </PivotItem>

            <PivotItem Header="Files">
                <ListView ItemsSource="{x:Bind ViewModel.Files}" SelectionMode="None" Margin="0,8,0,0">
                    <ListView.ItemTemplate>
                        <DataTemplate x:DataType="vm:DetailFileRow">
                            <Grid ColumnSpacing="12">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="90" />
                                    <ColumnDefinition Width="70" />
                                </Grid.ColumnDefinitions>
                                <TextBlock Text="{x:Bind Path}" TextTrimming="CharacterEllipsis" ToolTipService.ToolTip="{x:Bind Path}" />
                                <TextBlock Grid.Column="1" Text="{x:Bind Size}" HorizontalAlignment="Right" />
                                <TextBlock Grid.Column="2" Text="{x:Bind Done}" HorizontalAlignment="Right" />
                            </Grid>
                        </DataTemplate>
                    </ListView.ItemTemplate>
                </ListView>
            </PivotItem>

            <PivotItem Header="{x:Bind ViewModel.PeersHeader, Mode=OneWay}">
                <Grid Margin="0,8,0,0" RowSpacing="4">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="*" />
                    </Grid.RowDefinitions>
                    <Grid ColumnSpacing="8" Padding="12,0" Opacity="0.7">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="190" /><ColumnDefinition Width="*" /><ColumnDefinition Width="50" />
                            <ColumnDefinition Width="90" /><ColumnDefinition Width="90" /><ColumnDefinition Width="60" /><ColumnDefinition Width="110" />
                        </Grid.ColumnDefinitions>
                        <TextBlock Text="Address" /><TextBlock Grid.Column="1" Text="Client" /><TextBlock Grid.Column="2" Text="Country" />
                        <TextBlock Grid.Column="3" Text="Down" HorizontalAlignment="Right" /><TextBlock Grid.Column="4" Text="Up" HorizontalAlignment="Right" />
                        <TextBlock Grid.Column="5" Text="Has" HorizontalAlignment="Right" /><TextBlock Grid.Column="6" Text="Flags" />
                    </Grid>
                    <ListView Grid.Row="1" ItemsSource="{x:Bind ViewModel.Peers}" SelectionMode="None">
                        <ListView.ItemTemplate>
                            <DataTemplate x:DataType="vm:DetailPeerRow">
                                <Grid ColumnSpacing="8">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="190" /><ColumnDefinition Width="*" /><ColumnDefinition Width="50" />
                                        <ColumnDefinition Width="90" /><ColumnDefinition Width="90" /><ColumnDefinition Width="60" /><ColumnDefinition Width="110" />
                                    </Grid.ColumnDefinitions>
                                    <TextBlock Text="{x:Bind Address}" IsTextSelectionEnabled="True" />
                                    <TextBlock Grid.Column="1" Text="{x:Bind Client}" TextTrimming="CharacterEllipsis" />
                                    <TextBlock Grid.Column="2" Text="{x:Bind Country}" ToolTipService.ToolTip="{x:Bind CountryTip}" />
                                    <TextBlock Grid.Column="3" Text="{x:Bind Down}" HorizontalAlignment="Right" />
                                    <TextBlock Grid.Column="4" Text="{x:Bind Up}" HorizontalAlignment="Right" />
                                    <TextBlock Grid.Column="5" Text="{x:Bind Progress}" HorizontalAlignment="Right" />
                                    <TextBlock Grid.Column="6" Text="{x:Bind Flags}" Opacity="0.8" />
                                </Grid>
                            </DataTemplate>
                        </ListView.ItemTemplate>
                    </ListView>
                </Grid>
            </PivotItem>

            <PivotItem Header="Trackers">
                <Grid Margin="0,8,0,0" RowSpacing="6">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="*" />
                    </Grid.RowDefinitions>
                    <TextBlock Opacity="0.7" TextWrapping="Wrap"
                               Text="aria2 does not report tracker status and cannot change the trackers of a torrent that is already added. Public trackers from the cached list are added when a torrent is first added." />
                    <ListView Grid.Row="1" ItemsSource="{x:Bind ViewModel.Trackers}" SelectionMode="None">
                        <ListView.ItemTemplate>
                            <DataTemplate x:DataType="vm:DetailTrackerRow">
                                <Grid ColumnSpacing="12">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="60" />
                                    </Grid.ColumnDefinitions>
                                    <TextBlock Text="{x:Bind Url}" IsTextSelectionEnabled="True" TextTrimming="CharacterEllipsis" />
                                    <TextBlock Grid.Column="1" Text="{x:Bind Tier}" Opacity="0.7" />
                                </Grid>
                            </DataTemplate>
                        </ListView.ItemTemplate>
                    </ListView>
                </Grid>
            </PivotItem>

            <PivotItem Header="Pieces">
                <StackPanel Spacing="6" Margin="0,12,0,0">
                    <TextBlock Text="What you have" Style="{StaticResource BodyStrongTextBlockStyle}" />
                    <Rectangle Height="24" RadiusX="3" RadiusY="3" Fill="{x:Bind ViewModel.HaveBrush, Mode=OneWay}"
                               AutomationProperties.Name="Pieces downloaded" />
                    <TextBlock Text="Where it can be had (connected peers)" Style="{StaticResource BodyStrongTextBlockStyle}" Margin="0,12,0,0" />
                    <Rectangle Height="24" RadiusX="3" RadiusY="3" Fill="{x:Bind ViewModel.AvailabilityBrush, Mode=OneWay}"
                               AutomationProperties.Name="Piece availability among connected peers" />
                    <TextBlock Opacity="0.7" TextWrapping="Wrap" Margin="0,8,0,0"
                               Text="Green: downloaded. Teal: how many of the connected peers have that part (grey means none of them). Each slice is a share of the whole torrent." />
                </StackPanel>
            </PivotItem>
        </Pivot>
    </Grid>
</ContentDialog>
