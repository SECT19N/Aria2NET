<?xml version="1.0" encoding="utf-8"?>
<ContentDialog
    x:Class="Aria2NET.Pages.TorrentFilesDialog"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:vm="using:Aria2NET.ViewModels"
    Title="Choose what to download"
    PrimaryButtonText="Download"
    CloseButtonText="Cancel"
    DefaultButton="Primary">

    <ContentDialog.Resources>
        <!-- The default cap is ~548 px, which clipped long names and squeezed the size column. -->
        <x:Double x:Key="ContentDialogMaxWidth">900</x:Double>
        <x:Double x:Key="ContentDialogMaxHeight">900</x:Double>
    </ContentDialog.Resources>

    <StackPanel Spacing="16" MinWidth="760">
        <!-- What this is -->
        <StackPanel Spacing="4">
            <TextBlock x:Name="NameText" Style="{StaticResource BodyStrongTextBlockStyle}" TextWrapping="Wrap" MaxLines="2" TextTrimming="CharacterEllipsis" />
            <TextBlock x:Name="TotalText" Opacity="0.7" />
        </StackPanel>
        <InfoBar x:Name="NoteBar" Severity="Informational" IsOpen="False" IsClosable="False" />

        <!-- Which files -->
        <StackPanel Spacing="8">
            <Grid x:Name="Toolbar" ColumnSpacing="8">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="*" />
                </Grid.ColumnDefinitions>
                <Button Content="Select all" Click="SelectAll_Click" />
                <Button Grid.Column="1" Content="Select none" Click="SelectNone_Click" />
                <Button Grid.Column="2" Content="Expand all" Click="ExpandAll_Click" Margin="12,0,0,0" />
                <Button Grid.Column="3" Content="Collapse all" Click="CollapseAll_Click" />
                <TextBlock Grid.Column="4" x:Name="SummaryText" HorizontalAlignment="Right" VerticalAlignment="Center" Opacity="0.8" />
            </Grid>

            <Grid x:Name="ColumnHeader" ColumnSpacing="8" Padding="40,0,28,0">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="96" />
                </Grid.ColumnDefinitions>
                <TextBlock Text="Name" Opacity="0.7" Style="{StaticResource CaptionTextBlockStyle}" />
                <TextBlock Grid.Column="1" Text="Size" Opacity="0.7" HorizontalAlignment="Right" Style="{StaticResource CaptionTextBlockStyle}" />
            </Grid>

            <Border BorderThickness="1" CornerRadius="4"
                    BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
                    Background="{ThemeResource CardBackgroundFillColorDefaultBrush}">
                <ListView x:Name="FileList" ItemsSource="{x:Bind Rows}" SelectionMode="None" Height="320"
                          AutomationProperties.Name="Files in this torrent">
                    <ListView.ItemTemplate>
                        <DataTemplate x:DataType="vm:TorrentTreeItem">
                            <Grid Margin="{x:Bind Indent}" ColumnSpacing="6" Height="32">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="24" />
                                    <ColumnDefinition Width="Auto" />
                                    <ColumnDefinition Width="Auto" />
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="96" />
                                </Grid.ColumnDefinitions>
                                <Button Width="24" Height="24" Padding="0" BorderThickness="0" Background="Transparent"
                                        Visibility="{x:Bind ChevronVisibility}" Click="{x:Bind ToggleExpand}"
                                        AutomationProperties.Name="Expand or collapse">
                                    <FontIcon FontSize="10" Glyph="{x:Bind ChevronGlyph, Mode=OneWay}" />
                                </Button>
                                <CheckBox Grid.Column="1" MinWidth="0" Padding="0" VerticalAlignment="Center" IsThreeState="True"
                                          IsChecked="{x:Bind IsChecked, Mode=OneWay}" Click="{x:Bind Toggle}"
                                          AutomationProperties.Name="{x:Bind Name}" />
                                <FontIcon Grid.Column="2" FontSize="16" Opacity="0.75" VerticalAlignment="Center"
                                          Glyph="{x:Bind Glyph}" />
                                <TextBlock Grid.Column="3" Text="{x:Bind Name}" VerticalAlignment="Center" TextTrimming="CharacterEllipsis"
                                           ToolTipService.ToolTip="{x:Bind Name}" />
                                <TextBlock Grid.Column="4" Text="{x:Bind SizeText}" Opacity="0.7"
                                           HorizontalAlignment="Right" VerticalAlignment="Center" />
                            </Grid>
                        </DataTemplate>
                    </ListView.ItemTemplate>
                </ListView>
            </Border>
        </StackPanel>

        <!-- Where and how -->
        <StackPanel Spacing="12">
            <Grid ColumnSpacing="8">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>
                <TextBox x:Name="FolderBox" Header="Save to" TextChanged="FolderBox_TextChanged" />
                <Button x:Name="BrowseButton" Grid.Column="1" Content="Browse…" VerticalAlignment="Bottom" Click="Browse_Click" />
            </Grid>
            <TextBlock x:Name="SpaceText" TextWrapping="Wrap" />

            <Grid ColumnSpacing="16">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="*" />
                </Grid.ColumnDefinitions>
                <ComboBox x:Name="SeedBox" Header="After downloading" HorizontalAlignment="Stretch" SelectedIndex="0" SelectionChanged="Seed_Changed">
                    <ComboBoxItem Content="Seed until ratio 1.0 (default)" />
                    <ComboBoxItem Content="Seed forever" />
                    <ComboBoxItem Content="Seed until a ratio I choose" />
                    <ComboBoxItem Content="Don't seed" />
                </ComboBox>
                <ComboBox x:Name="AllocationBox" Grid.Column="1" Header="Disk space" HorizontalAlignment="Stretch" SelectedIndex="0">
                    <ComboBoxItem Content="Grow files as data arrives (default)" />
                    <ComboBoxItem Content="Reserve the full size first (slow without admin rights)" />
                </ComboBox>
            </Grid>
            <NumberBox x:Name="RatioBox" Header="Stop seeding at ratio" Minimum="0.1" Maximum="100" Value="2" SmallChange="0.5"
                       SpinButtonPlacementMode="Inline" Visibility="Collapsed" HorizontalAlignment="Left" MinWidth="200" />
        </StackPanel>
    </StackPanel>
</ContentDialog>
