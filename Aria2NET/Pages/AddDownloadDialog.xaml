<?xml version="1.0" encoding="utf-8"?>
<ContentDialog x:Uid="AddDownloadDialog_ContentDialog1"
    x:Class="Aria2NET.Pages.AddDownloadDialog"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    Title="Add downloads"
    PrimaryButtonText="Download"
    CloseButtonText="Cancel"
    DefaultButton="Primary"
    IsPrimaryButtonEnabled="False">

    <StackPanel Spacing="12" MinWidth="460">
        <TextBox x:Uid="AddDownloadDialog_UrlsBox" x:Name="UrlsBox" Header="Links and files (one per line)" AcceptsReturn="True" TextWrapping="NoWrap"
                 Height="130" ScrollViewer.VerticalScrollBarVisibility="Auto" ScrollViewer.HorizontalScrollBarVisibility="Auto"
                 PlaceholderText="https://example.com/file.zip, magnet:?xt=..., or the path of a .torrent file" TextChanged="UrlsBox_TextChanged"/>
        <Grid ColumnSpacing="8">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>
            <TextBlock x:Name="ValidationText" Opacity="0.8" TextWrapping="Wrap" VerticalAlignment="Center" />
            <Button x:Uid="AddDownloadDialog_Button1" Grid.Column="1" Content="Add .torrent / .metalink…" Click="BrowseFiles_Click"/>
        </Grid>

        <Grid ColumnSpacing="8">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>
            <TextBox x:Uid="AddDownloadDialog_FolderBox" x:Name="FolderBox" Header="Save to" TextChanged="FolderBox_TextChanged"/>
            <Button x:Uid="AddDownloadDialog_Button2" Grid.Column="1" Content="Browse…" VerticalAlignment="Bottom" Click="Browse_Click"/>
        </Grid>

        <TextBox x:Uid="AddDownloadDialog_FileNameBox" x:Name="FileNameBox" Header="File name (optional, single link only)" PlaceholderText="Use the name from the server"/>

        <Expander x:Uid="AddDownloadDialog_MoreOptions" x:Name="MoreOptions" Header="More options" HorizontalAlignment="Stretch" HorizontalContentAlignment="Stretch">
            <StackPanel Spacing="10">
                <Grid ColumnSpacing="8">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>
                    <ComboBox x:Uid="AddDownloadDialog_PresetBox" x:Name="PresetBox" Header="Site preset" HorizontalAlignment="Stretch" PlaceholderText="None" SelectionChanged="Preset_Changed"/>
                    <Button x:Uid="AddDownloadDialog_SavePresetButton" x:Name="SavePresetButton" Grid.Column="1" Content="Save as…" VerticalAlignment="Bottom" Click="SavePreset_Click"/>
                    <Button x:Uid="AddDownloadDialog_DeletePresetButton" x:Name="DeletePresetButton" Grid.Column="2" Content="Delete" VerticalAlignment="Bottom" IsEnabled="False" Click="DeletePreset_Click"/>
                </Grid>
                <TextBox x:Uid="AddDownloadDialog_PresetNameBox" x:Name="PresetNameBox" Header="Preset name" Visibility="Collapsed" KeyDown="PresetName_KeyDown" PlaceholderText="Press Enter to save"/>
                <TextBox x:Uid="AddDownloadDialog_HeadersBox" x:Name="HeadersBox" Header="Headers (one per line, Name: value)" AcceptsReturn="True" TextWrapping="NoWrap" Height="70"
                         ScrollViewer.VerticalScrollBarVisibility="Auto" PlaceholderText="Authorization: Bearer …" TextChanged="Option_Changed"/>
                <TextBox x:Uid="AddDownloadDialog_RefererBox" x:Name="RefererBox" Header="Referer" PlaceholderText="https://example.com/page" TextChanged="Option_Changed"/>
                <TextBox x:Uid="AddDownloadDialog_CookieBox" x:Name="CookieBox" Header="Cookie" PlaceholderText="name=value; other=value" TextChanged="Option_Changed"/>
                <StackPanel Orientation="Horizontal" Spacing="8">
                    <TextBox x:Uid="AddDownloadDialog_UserBox" x:Name="UserBox" Header="User name (HTTP / FTP)" MinWidth="170" TextChanged="Option_Changed"/>
                    <PasswordBox x:Uid="AddDownloadDialog_PasswordBox" x:Name="PasswordBox" Header="Password" MinWidth="170" PasswordChanged="Option_Changed"/>
                </StackPanel>
                <TextBox x:Uid="AddDownloadDialog_ChecksumBox" x:Name="ChecksumBox" Header="Checksum (verified when done)" PlaceholderText="sha-256=…" TextChanged="Option_Changed"/>
                <StackPanel Orientation="Horizontal" Spacing="8">
                    <NumberBox x:Uid="AddDownloadDialog_DownLimitBox" x:Name="DownLimitBox" Header="Download limit (KiB/s)" Minimum="0" Maximum="10000000" Value="0" SpinButtonPlacementMode="Inline" SmallChange="100" LargeChange="1000" ValueChanged="Limit_Changed"/>
                    <NumberBox x:Uid="AddDownloadDialog_UpLimitBox" x:Name="UpLimitBox" Header="Upload limit (KiB/s)" Minimum="0" Maximum="10000000" Value="0" SpinButtonPlacementMode="Inline" SmallChange="100" LargeChange="1000" ValueChanged="Limit_Changed"/>
                </StackPanel>
                <TextBlock x:Uid="AddDownloadDialog_TextBlock1" Text="0 means no limit. These apply to this add only. Passwords and cookies are not saved, except a cookie inside a preset, which is stored encrypted for your Windows account. While a download is unfinished, aria2 keeps its login in its own session file." Opacity="0.7" TextWrapping="Wrap"/>
                <TextBlock x:Name="OptionsError" Foreground="{ThemeResource SystemFillColorCriticalBrush}" TextWrapping="Wrap" />
            </StackPanel>
        </Expander>
    </StackPanel>
</ContentDialog>
