<?xml version="1.0" encoding="utf-8"?>
<Page
    x:Class="Aria2NET.Pages.DownloadsPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:vm="using:Aria2NET.ViewModels">

    <Page.KeyboardAccelerators>
        <KeyboardAccelerator Key="V" Modifiers="Control" Invoked="Paste_Invoked" />
    </Page.KeyboardAccelerators>

    <Grid Padding="24,8,24,16" RowSpacing="12">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <Grid ColumnSpacing="16">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="*" />
            </Grid.ColumnDefinitions>
            <Button x:Name="AddButton" Click="Add_Click" IsEnabled="{x:Bind ViewModel.IsEngineUp, Mode=OneWay}"
                    Style="{StaticResource AccentButtonStyle}">
                <StackPanel Orientation="Horizontal" Spacing="8">
                    <FontIcon Glyph="&#xE710;" FontSize="14" />
                    <TextBlock Text="Add URL" />
                </StackPanel>
            </Button>
            <TextBlock Grid.Column="1" Text="{x:Bind ViewModel.StatsText, Mode=OneWay}" HorizontalAlignment="Right"
                       VerticalAlignment="Center" Opacity="0.8" />
        </Grid>

        <InfoBar Grid.Row="1" IsOpen="{x:Bind ViewModel.IsEngineDown, Mode=OneWay}" IsClosable="False" Severity="Warning"
                 Title="Download engine is not running"
                 Message="Adding downloads is disabled until aria2 is running. Use the status bar message or Restart engine." />

        <Grid Grid.Row="2">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="*" />
            </Grid.RowDefinitions>

            <Grid x:Name="ColumnHeader" Padding="12,0,12,6" ColumnSpacing="12" Opacity="0.7"
                  Visibility="{x:Bind ViewModel.HasRows, Mode=OneWay}">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="170" />
                    <ColumnDefinition Width="150" />
                    <ColumnDefinition Width="100" />
                    <ColumnDefinition Width="80" />
                    <ColumnDefinition Width="100" />
                </Grid.ColumnDefinitions>
                <TextBlock Text="Name" />
                <TextBlock Grid.Column="1" Text="Size" />
                <TextBlock Grid.Column="2" Text="Progress" />
                <TextBlock Grid.Column="3" Text="Speed" />
                <TextBlock Grid.Column="4" Text="ETA" />
                <TextBlock Grid.Column="5" Text="Status" />
            </Grid>

            <ListView Grid.Row="1" ItemsSource="{x:Bind ViewModel.Rows}" SelectionMode="Extended"
                      Visibility="{x:Bind ViewModel.HasRows, Mode=OneWay}">
                <ListView.ItemContainerStyle>
                    <Style TargetType="ListViewItem" BasedOn="{StaticResource DefaultListViewItemStyle}">
                        <Setter Property="HorizontalContentAlignment" Value="Stretch" />
                        <Setter Property="MinHeight" Value="44" />
                    </Style>
                </ListView.ItemContainerStyle>
                <ListView.ItemTemplate>
                    <DataTemplate x:DataType="vm:DownloadRowViewModel">
                        <Grid ColumnSpacing="12">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="170" />
                                <ColumnDefinition Width="150" />
                                <ColumnDefinition Width="100" />
                                <ColumnDefinition Width="80" />
                                <ColumnDefinition Width="100" />
                            </Grid.ColumnDefinitions>
                            <Grid.ContextFlyout>
                                <MenuFlyout>
                                    <MenuFlyoutItem Text="Open folder" Command="{x:Bind OpenFolderCommand}">
                                        <MenuFlyoutItem.Icon><FontIcon Glyph="&#xE838;" /></MenuFlyoutItem.Icon>
                                    </MenuFlyoutItem>
                                    <MenuFlyoutItem Text="Copy URL" Command="{x:Bind CopyUrlCommand}">
                                        <MenuFlyoutItem.Icon><FontIcon Glyph="&#xE8C8;" /></MenuFlyoutItem.Icon>
                                    </MenuFlyoutItem>
                                    <MenuFlyoutSeparator />
                                    <!-- Wired up in 0.3. -->
                                    <MenuFlyoutItem Text="Pause" IsEnabled="False" />
                                    <MenuFlyoutItem Text="Resume" IsEnabled="False" />
                                    <MenuFlyoutItem Text="Remove" IsEnabled="False" />
                                </MenuFlyout>
                            </Grid.ContextFlyout>
                            <TextBlock Text="{x:Bind Name, Mode=OneWay}" VerticalAlignment="Center" TextTrimming="CharacterEllipsis"
                                       ToolTipService.ToolTip="{x:Bind Name, Mode=OneWay}" />
                            <TextBlock Grid.Column="1" Text="{x:Bind SizeText, Mode=OneWay}" VerticalAlignment="Center" />
                            <ProgressBar Grid.Column="2" Minimum="0" Maximum="100" Value="{x:Bind Progress, Mode=OneWay}"
                                         IsIndeterminate="{x:Bind IsIndeterminate, Mode=OneWay}" VerticalAlignment="Center" />
                            <TextBlock Grid.Column="3" Text="{x:Bind SpeedText, Mode=OneWay}" VerticalAlignment="Center" />
                            <TextBlock Grid.Column="4" Text="{x:Bind EtaText, Mode=OneWay}" VerticalAlignment="Center" />
                            <TextBlock Grid.Column="5" Text="{x:Bind StatusText, Mode=OneWay}" VerticalAlignment="Center"
                                       ToolTipService.ToolTip="{x:Bind StatusTip, Mode=OneWay}" />
                        </Grid>
                    </DataTemplate>
                </ListView.ItemTemplate>
            </ListView>

            <StackPanel Grid.RowSpan="2" HorizontalAlignment="Center" VerticalAlignment="Center" Spacing="10"
                        Visibility="{x:Bind ViewModel.IsEmpty, Mode=OneWay}">
                <FontIcon Glyph="&#xE896;" FontSize="48" Opacity="0.6" />
                <TextBlock Text="Paste a link to start" Style="{StaticResource SubtitleTextBlockStyle}" HorizontalAlignment="Center" />
                <TextBlock Text="Press Ctrl+V anywhere on this page, or use the button." Opacity="0.7" HorizontalAlignment="Center" />
                <Button Click="Add_Click" HorizontalAlignment="Center" Padding="24,10" Style="{StaticResource AccentButtonStyle}"
                        IsEnabled="{x:Bind ViewModel.IsEngineUp, Mode=OneWay}" Content="Add URL" />
            </StackPanel>
        </Grid>
    </Grid>
</Page>
