<?xml version="1.0" encoding="utf-8"?>
<Page
    x:Class="Aria2NET.Pages.DownloadsPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:vm="using:Aria2NET.ViewModels"
    Loaded="Page_Loaded" Unloaded="Page_Unloaded">

    <Page.KeyboardAccelerators>
        <KeyboardAccelerator Key="V" Modifiers="Control" Invoked="Paste_Invoked" />
    </Page.KeyboardAccelerators>

    <Page.Resources>
        <Style x:Key="HeaderButtonStyle" TargetType="Button" BasedOn="{StaticResource DefaultButtonStyle}">
            <Setter Property="Background" Value="Transparent" />
            <Setter Property="BorderThickness" Value="0" />
            <Setter Property="Padding" Value="0,2" />
            <Setter Property="HorizontalAlignment" Value="Left" />
        </Style>
    </Page.Resources>

    <Grid Padding="24,8,24,16" RowSpacing="8">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <CommandBar Grid.Row="0" DefaultLabelPosition="Right" HorizontalAlignment="Left" Background="Transparent" IsDynamicOverflowEnabled="True">
            <AppBarButton x:Name="AddButton" Label="Add URL" Click="Add_Click" IsEnabled="{x:Bind ViewModel.IsEngineUp, Mode=OneWay}"
                          ToolTipService.ToolTip="Add downloads (Ctrl+V pastes links)">
                <AppBarButton.Icon><FontIcon Glyph="&#xE710;" /></AppBarButton.Icon>
            </AppBarButton>
            <AppBarSeparator />
            <AppBarButton Label="Pause" Click="Pause_Click" IsEnabled="{x:Bind ViewModel.CanPause, Mode=OneWay}"
                          ToolTipService.ToolTip="Pause the selected downloads (Space)">
                <AppBarButton.Icon><FontIcon Glyph="&#xE769;" /></AppBarButton.Icon>
            </AppBarButton>
            <AppBarButton Label="Resume" Click="Resume_Click" IsEnabled="{x:Bind ViewModel.CanResume, Mode=OneWay}"
                          ToolTipService.ToolTip="Resume the selected downloads (Space)">
                <AppBarButton.Icon><FontIcon Glyph="&#xE768;" /></AppBarButton.Icon>
            </AppBarButton>
            <AppBarButton Label="Retry" Click="Retry_Click" IsEnabled="{x:Bind ViewModel.CanRetry, Mode=OneWay}"
                          ToolTipService.ToolTip="Start failed downloads again">
                <AppBarButton.Icon><FontIcon Glyph="&#xE72C;" /></AppBarButton.Icon>
            </AppBarButton>
            <AppBarButton Label="Remove" IsEnabled="{x:Bind ViewModel.CanRemove, Mode=OneWay}" ToolTipService.ToolTip="Remove the selected downloads (Del)">
                <AppBarButton.Icon><FontIcon Glyph="&#xE74D;" /></AppBarButton.Icon>
                <AppBarButton.Flyout>
                    <MenuFlyout>
                        <MenuFlyoutItem Text="Remove from list" Click="Remove_Click" KeyboardAcceleratorTextOverride="Del" />
                        <MenuFlyoutItem Text="Remove and delete file" Click="RemoveDelete_Click" KeyboardAcceleratorTextOverride="Shift+Del" />
                    </MenuFlyout>
                </AppBarButton.Flyout>
            </AppBarButton>
            <AppBarSeparator />
            <AppBarButton Label="Open folder" Click="OpenFolder_Click" IsEnabled="{x:Bind ViewModel.CanOpenFolder, Mode=OneWay}"
                          ToolTipService.ToolTip="Show the file in its folder">
                <AppBarButton.Icon><FontIcon Glyph="&#xE838;" /></AppBarButton.Icon>
            </AppBarButton>

            <CommandBar.SecondaryCommands>
                <AppBarButton Label="Pause all" Click="PauseAll_Click" IsEnabled="{x:Bind ViewModel.CanPauseAll, Mode=OneWay}" />
                <AppBarButton Label="Resume all" Click="ResumeAll_Click" IsEnabled="{x:Bind ViewModel.CanResumeAll, Mode=OneWay}" />
                <AppBarSeparator />
                <AppBarButton Label="Clear completed" Click="ClearCompleted_Click" IsEnabled="{x:Bind ViewModel.CanClearCompleted, Mode=OneWay}" />
                <AppBarButton Label="Clear failed" Click="ClearFailed_Click" IsEnabled="{x:Bind ViewModel.CanClearFailed, Mode=OneWay}" />
            </CommandBar.SecondaryCommands>
        </CommandBar>

        <Grid Grid.Row="1" ColumnSpacing="16">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>
            <SelectorBar x:Name="FilterBar" SelectionChanged="Filter_SelectionChanged" HorizontalAlignment="Left">
                <SelectorBarItem Tag="All" Text="{x:Bind ViewModel.AllLabel, Mode=OneWay}" />
                <SelectorBarItem Tag="Downloading" Text="{x:Bind ViewModel.DownloadingLabel, Mode=OneWay}" />
                <SelectorBarItem Tag="Waiting" Text="{x:Bind ViewModel.WaitingLabel, Mode=OneWay}" />
                <SelectorBarItem Tag="Paused" Text="{x:Bind ViewModel.PausedLabel, Mode=OneWay}" />
                <SelectorBarItem Tag="Completed" Text="{x:Bind ViewModel.CompletedLabel, Mode=OneWay}" />
                <SelectorBarItem Tag="Failed" Text="{x:Bind ViewModel.FailedLabel, Mode=OneWay}" />
            </SelectorBar>
            <TextBlock Grid.Column="1" Text="{x:Bind ViewModel.StatsText, Mode=OneWay}" VerticalAlignment="Center" Opacity="0.8" />
        </Grid>

        <InfoBar Grid.Row="2" IsOpen="{x:Bind ViewModel.IsEngineDown, Mode=OneWay}" IsClosable="False" Severity="Warning"
                 Title="Download engine is not running"
                 Message="Adding downloads is disabled until aria2 is running. Use the status bar message or Restart engine." />

        <InfoBar Grid.Row="3" IsOpen="{x:Bind ViewModel.HasActionMessage, Mode=OneWay}" Severity="Error" Title="That did not work"
                 Message="{x:Bind ViewModel.ActionMessage, Mode=OneWay}" CloseButtonClick="ActionMessage_Closed" />

        <Grid Grid.Row="4">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="*" />
            </Grid.RowDefinitions>

            <Grid x:Name="ColumnHeader" Padding="12,0,12,6" ColumnSpacing="12" Visibility="{x:Bind ViewModel.HasRows, Mode=OneWay}">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="170" />
                    <ColumnDefinition Width="150" />
                    <ColumnDefinition Width="100" />
                    <ColumnDefinition Width="80" />
                    <ColumnDefinition Width="100" />
                </Grid.ColumnDefinitions>
                <Button Style="{StaticResource HeaderButtonStyle}" Tag="Name" Click="Header_Click" Content="{x:Bind ViewModel.NameHeader, Mode=OneWay}" />
                <Button Grid.Column="1" Style="{StaticResource HeaderButtonStyle}" Tag="Size" Click="Header_Click" Content="{x:Bind ViewModel.SizeHeader, Mode=OneWay}" />
                <Button Grid.Column="2" Style="{StaticResource HeaderButtonStyle}" Tag="Progress" Click="Header_Click" Content="{x:Bind ViewModel.ProgressHeader, Mode=OneWay}" />
                <Button Grid.Column="3" Style="{StaticResource HeaderButtonStyle}" Tag="Speed" Click="Header_Click" Content="{x:Bind ViewModel.SpeedHeader, Mode=OneWay}" />
                <Button Grid.Column="4" Style="{StaticResource HeaderButtonStyle}" Tag="Eta" Click="Header_Click" Content="{x:Bind ViewModel.EtaHeader, Mode=OneWay}" />
                <Button Grid.Column="5" Style="{StaticResource HeaderButtonStyle}" Tag="Status" Click="Header_Click" Content="{x:Bind ViewModel.StatusHeader, Mode=OneWay}" />
            </Grid>

            <ListView x:Name="DownloadList" Grid.Row="1" ItemsSource="{x:Bind ViewModel.Rows}" SelectionMode="Extended"
                      Visibility="{x:Bind ViewModel.HasRows, Mode=OneWay}"
                      SelectionChanged="List_SelectionChanged" PreviewKeyDown="List_KeyDown" ContextRequested="List_ContextRequested"
                      DoubleTapped="List_DoubleTapped">
                <FlyoutBase.AttachedFlyout>
                    <MenuFlyout x:Name="RowMenu">
                        <MenuFlyoutItem Text="Pause" Click="Pause_Click" IsEnabled="{x:Bind ViewModel.CanPause, Mode=OneWay}" KeyboardAcceleratorTextOverride="Space">
                            <MenuFlyoutItem.Icon><FontIcon Glyph="&#xE769;" /></MenuFlyoutItem.Icon>
                        </MenuFlyoutItem>
                        <MenuFlyoutItem Text="Resume" Click="Resume_Click" IsEnabled="{x:Bind ViewModel.CanResume, Mode=OneWay}" KeyboardAcceleratorTextOverride="Space">
                            <MenuFlyoutItem.Icon><FontIcon Glyph="&#xE768;" /></MenuFlyoutItem.Icon>
                        </MenuFlyoutItem>
                        <MenuFlyoutItem Text="Retry" Click="Retry_Click" IsEnabled="{x:Bind ViewModel.CanRetry, Mode=OneWay}">
                            <MenuFlyoutItem.Icon><FontIcon Glyph="&#xE72C;" /></MenuFlyoutItem.Icon>
                        </MenuFlyoutItem>
                        <MenuFlyoutSeparator />
                        <MenuFlyoutItem Text="Open file" Click="OpenFile_Click" IsEnabled="{x:Bind ViewModel.CanOpenFile, Mode=OneWay}" KeyboardAcceleratorTextOverride="Enter">
                            <MenuFlyoutItem.Icon><FontIcon Glyph="&#xE8E5;" /></MenuFlyoutItem.Icon>
                        </MenuFlyoutItem>
                        <MenuFlyoutItem Text="Open folder" Click="OpenFolder_Click" IsEnabled="{x:Bind ViewModel.CanOpenFolder, Mode=OneWay}">
                            <MenuFlyoutItem.Icon><FontIcon Glyph="&#xE838;" /></MenuFlyoutItem.Icon>
                        </MenuFlyoutItem>
                        <MenuFlyoutItem Text="Copy URL" Click="CopyUrl_Click" IsEnabled="{x:Bind ViewModel.CanCopyUrl, Mode=OneWay}">
                            <MenuFlyoutItem.Icon><FontIcon Glyph="&#xE8C8;" /></MenuFlyoutItem.Icon>
                        </MenuFlyoutItem>
                        <MenuFlyoutSeparator />
                        <MenuFlyoutItem Text="Speed limit…" Click="SpeedLimit_Click" IsEnabled="{x:Bind ViewModel.CanSetSpeedLimit, Mode=OneWay}" />
                        <MenuFlyoutItem Text="Rename…" Click="Rename_Click" IsEnabled="{x:Bind ViewModel.CanRename, Mode=OneWay}" />
                        <MenuFlyoutItem Text="Change folder…" Click="ChangeFolder_Click" IsEnabled="{x:Bind ViewModel.CanChangeFolder, Mode=OneWay}" />
                        <MenuFlyoutSubItem Text="Queue">
                            <MenuFlyoutItem Text="Start now" Click="ForceStart_Click" IsEnabled="{x:Bind ViewModel.CanForceStart, Mode=OneWay}" />
                            <MenuFlyoutSeparator />
                            <MenuFlyoutItem Text="Move to top" Click="MoveTop_Click" IsEnabled="{x:Bind ViewModel.CanMove, Mode=OneWay}" />
                            <MenuFlyoutItem Text="Move up" Click="MoveUp_Click" IsEnabled="{x:Bind ViewModel.CanMove, Mode=OneWay}" />
                            <MenuFlyoutItem Text="Move down" Click="MoveDown_Click" IsEnabled="{x:Bind ViewModel.CanMove, Mode=OneWay}" />
                            <MenuFlyoutItem Text="Move to bottom" Click="MoveBottom_Click" IsEnabled="{x:Bind ViewModel.CanMove, Mode=OneWay}" />
                        </MenuFlyoutSubItem>
                        <MenuFlyoutSeparator />
                        <MenuFlyoutItem Text="Remove from list" Click="Remove_Click" IsEnabled="{x:Bind ViewModel.CanRemove, Mode=OneWay}" KeyboardAcceleratorTextOverride="Del">
                            <MenuFlyoutItem.Icon><FontIcon Glyph="&#xE74D;" /></MenuFlyoutItem.Icon>
                        </MenuFlyoutItem>
                        <MenuFlyoutItem Text="Remove and delete file" Click="RemoveDelete_Click" IsEnabled="{x:Bind ViewModel.CanRemove, Mode=OneWay}" KeyboardAcceleratorTextOverride="Shift+Del" />
                        <MenuFlyoutSeparator />
                        <MenuFlyoutItem Text="Properties" Click="Properties_Click" IsEnabled="{x:Bind ViewModel.CanShowProperties, Mode=OneWay}">
                            <MenuFlyoutItem.Icon><FontIcon Glyph="&#xE946;" /></MenuFlyoutItem.Icon>
                        </MenuFlyoutItem>
                    </MenuFlyout>
                </FlyoutBase.AttachedFlyout>
                <ListView.ItemContainerStyle>
                    <Style TargetType="ListViewItem" BasedOn="{StaticResource DefaultListViewItemStyle}">
                        <Setter Property="HorizontalContentAlignment" Value="Stretch" />
                        <Setter Property="MinHeight" Value="44" />
                    </Style>
                </ListView.ItemContainerStyle>
                <ListView.ItemTemplate>
                    <DataTemplate x:DataType="vm:DownloadRowViewModel">
                        <Grid ColumnSpacing="12" AutomationProperties.Name="{x:Bind AccessibleName, Mode=OneWay}">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="170" />
                                <ColumnDefinition Width="150" />
                                <ColumnDefinition Width="100" />
                                <ColumnDefinition Width="80" />
                                <ColumnDefinition Width="100" />
                            </Grid.ColumnDefinitions>
                            <TextBlock Text="{x:Bind Name, Mode=OneWay}" VerticalAlignment="Center" TextTrimming="CharacterEllipsis"
                                       ToolTipService.ToolTip="{x:Bind Name, Mode=OneWay}" />
                            <TextBlock Grid.Column="1" Text="{x:Bind SizeText, Mode=OneWay}" VerticalAlignment="Center" />
                            <ProgressBar Grid.Column="2" Minimum="0" Maximum="100" Value="{x:Bind Progress, Mode=OneWay}"
                                         Foreground="{x:Bind ProgressBrush, Mode=OneWay}"
                                         IsIndeterminate="{x:Bind IsIndeterminate, Mode=OneWay}" VerticalAlignment="Center" />
                            <TextBlock Grid.Column="3" Text="{x:Bind SpeedText, Mode=OneWay}" VerticalAlignment="Center" />
                            <TextBlock Grid.Column="4" Text="{x:Bind EtaText, Mode=OneWay}" VerticalAlignment="Center" />
                            <TextBlock Grid.Column="5" Text="{x:Bind StatusText, Mode=OneWay}" VerticalAlignment="Center"
                                       ToolTipService.ToolTip="{x:Bind StatusTip, Mode=OneWay}" />
                        </Grid>
                    </DataTemplate>
                </ListView.ItemTemplate>
            </ListView>

            <TextBlock Grid.RowSpan="2" HorizontalAlignment="Center" VerticalAlignment="Center" Opacity="0.7"
                       Text="No downloads match this filter." Visibility="{x:Bind ViewModel.IsFilteredEmpty, Mode=OneWay}" />

            <StackPanel Grid.RowSpan="2" HorizontalAlignment="Center" VerticalAlignment="Center" Spacing="10"
                        Visibility="{x:Bind ViewModel.IsEmpty, Mode=OneWay}">
                <FontIcon Glyph="&#xE896;" FontSize="48" Opacity="0.6" />
                <TextBlock Text="Paste a link to start" Style="{StaticResource SubtitleTextBlockStyle}" HorizontalAlignment="Center" />
                <TextBlock Text="Press Ctrl+V anywhere on this page, or use the button." Opacity="0.7" HorizontalAlignment="Center" />
                <Button Click="Add_Click" HorizontalAlignment="Center" Padding="24,10" Style="{StaticResource AccentButtonStyle}"
                        IsEnabled="{x:Bind ViewModel.IsEngineUp, Mode=OneWay}" Content="Add URL" />
            </StackPanel>
        </Grid>

        <InfoBar Grid.Row="5" IsOpen="{x:Bind ViewModel.IsUndoVisible, Mode=OneWay}" IsClosable="False" Severity="Informational"
                 Title="{x:Bind ViewModel.UndoText, Mode=OneWay}">
            <InfoBar.ActionButton>
                <Button Content="Undo" Click="Undo_Click" />
            </InfoBar.ActionButton>
        </InfoBar>
    </Grid>
</Page>
