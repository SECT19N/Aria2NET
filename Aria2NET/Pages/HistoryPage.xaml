<?xml version="1.0" encoding="utf-8"?>
<Page
    x:Class="Aria2NET.Pages.HistoryPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:vm="using:Aria2NET.ViewModels"
    Loaded="Page_Loaded">

    <Page.KeyboardAccelerators>
        <KeyboardAccelerator Key="F" Modifiers="Control" Invoked="Find_Invoked" />
        <KeyboardAccelerator Key="F5" Invoked="Refresh_Invoked" />
    </Page.KeyboardAccelerators>

    <Grid Padding="24,8,24,16" RowSpacing="8">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <CommandBar Grid.Row="0" DefaultLabelPosition="Right" HorizontalAlignment="Left" Background="Transparent" IsDynamicOverflowEnabled="True"
                    Visibility="{x:Bind ViewModel.IsAvailable}">
            <AppBarButton x:Uid="HistoryPage_AppBarButton1" Label="Download again" Click="Redownload_Click" IsEnabled="{x:Bind ViewModel.CanRedownload, Mode=OneWay}"
                          ToolTipService.ToolTip="Download the selected links again as new copies">
                <AppBarButton.Icon><FontIcon Glyph="&#xE72C;" /></AppBarButton.Icon>
            </AppBarButton>
            <AppBarButton x:Uid="HistoryPage_AppBarButton2" Label="Download to…" Click="DownloadTo_Click" IsEnabled="{x:Bind ViewModel.CanRedownload, Mode=OneWay}"
                          ToolTipService.ToolTip="Download the selected links again into a folder you choose">
                <AppBarButton.Icon><FontIcon Glyph="&#xE8DE;" /></AppBarButton.Icon>
            </AppBarButton>
            <AppBarSeparator />
            <AppBarButton x:Uid="HistoryPage_AppBarButton3" Label="Open file" Click="OpenFile_Click" IsEnabled="{x:Bind ViewModel.CanOpenFile, Mode=OneWay}">
                <AppBarButton.Icon><FontIcon Glyph="&#xE8E5;" /></AppBarButton.Icon>
            </AppBarButton>
            <AppBarButton x:Uid="HistoryPage_AppBarButton4" Label="Open folder" Click="OpenFolder_Click" IsEnabled="{x:Bind ViewModel.CanOpenFolder, Mode=OneWay}">
                <AppBarButton.Icon><FontIcon Glyph="&#xE838;" /></AppBarButton.Icon>
            </AppBarButton>
            <AppBarButton x:Uid="HistoryPage_AppBarButton5" Label="Copy URL" Click="CopyUrl_Click" IsEnabled="{x:Bind ViewModel.CanCopyUrl, Mode=OneWay}">
                <AppBarButton.Icon><FontIcon Glyph="&#xE8C8;" /></AppBarButton.Icon>
            </AppBarButton>
            <AppBarSeparator />
            <AppBarButton x:Uid="HistoryPage_AppBarButton6" Label="Remove from history" Click="Delete_Click" IsEnabled="{x:Bind ViewModel.CanDelete, Mode=OneWay}"
                          ToolTipService.ToolTip="Forget the selected entries (files are not deleted)">
                <AppBarButton.Icon><FontIcon Glyph="&#xE74D;" /></AppBarButton.Icon>
            </AppBarButton>
            <AppBarButton x:Uid="HistoryPage_AppBarButton7" Label="Export">
                <AppBarButton.Icon><FontIcon Glyph="&#xE78C;" /></AppBarButton.Icon>
                <AppBarButton.Flyout>
                    <MenuFlyout>
                        <MenuFlyoutItem x:Uid="HistoryPage_MenuFlyoutItem1" Text="Export as CSV…" Click="ExportCsv_Click"/>
                        <MenuFlyoutItem x:Uid="HistoryPage_MenuFlyoutItem2" Text="Export as JSON…" Click="ExportJson_Click"/>
                    </MenuFlyout>
                </AppBarButton.Flyout>
            </AppBarButton>
            <AppBarButton x:Uid="HistoryPage_AppBarButton8" Label="Refresh" Click="Refresh_Click" ToolTipService.ToolTip="Reload the list (F5)">
                <AppBarButton.Icon><FontIcon Glyph="&#xE72C;" /></AppBarButton.Icon>
            </AppBarButton>

            <CommandBar.SecondaryCommands>
                <AppBarButton x:Uid="HistoryPage_AppBarButton9" Label="Clear history…" Click="ClearHistory_Click"/>
            </CommandBar.SecondaryCommands>
        </CommandBar>

        <InfoBar x:Uid="HistoryPage_InfoBar1" Grid.Row="1" IsOpen="{x:Bind ViewModel.IsUnavailable}" IsClosable="False" Severity="Warning"
                 Title="History is not available" Message="{x:Bind ViewModel.UnavailableText}"/>

        <Grid Grid.Row="2" ColumnSpacing="8" Visibility="{x:Bind ViewModel.IsAvailable}">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>
            <TextBox x:Uid="HistoryPage_SearchBox" x:Name="SearchBox" PlaceholderText="Search name, link or path (Ctrl+F)"
                     Text="{x:Bind ViewModel.SearchText, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"/>
            <ComboBox x:Uid="HistoryPage_ComboBox1" Grid.Column="1" ItemsSource="{x:Bind ViewModel.Sorts}" SelectedIndex="{x:Bind ViewModel.SortIndex, Mode=TwoWay}"
                      AutomationProperties.Name="Sort by" MinWidth="140"/>
            <Button Grid.Column="2" Click="Direction_Click" Content="{x:Bind ViewModel.DirectionText, Mode=OneWay}" MinWidth="110" />
        </Grid>

        <ScrollViewer Grid.Row="3" HorizontalScrollBarVisibility="Auto" VerticalScrollBarVisibility="Disabled" Visibility="{x:Bind ViewModel.IsAvailable}">
            <StackPanel Orientation="Horizontal" Spacing="8" Padding="0,0,0,8">
                <ComboBox x:Uid="HistoryPage_ComboBox2" ItemsSource="{x:Bind ViewModel.Statuses}" SelectedIndex="{x:Bind ViewModel.StatusIndex, Mode=TwoWay}"
                          AutomationProperties.Name="Status" MinWidth="140"/>
                <ComboBox x:Uid="HistoryPage_ComboBox3" ItemsSource="{x:Bind ViewModel.Types}" SelectedIndex="{x:Bind ViewModel.TypeIndex, Mode=TwoWay}"
                          AutomationProperties.Name="File type" MinWidth="130"/>
                <ComboBox x:Uid="HistoryPage_ComboBox4" ItemsSource="{x:Bind ViewModel.Sites}" SelectedIndex="{x:Bind ViewModel.SiteIndex, Mode=TwoWay}"
                          AutomationProperties.Name="Website" MinWidth="170"/>
                <CalendarDatePicker x:Uid="HistoryPage_CalendarDatePicker1" PlaceholderText="Added from" Date="{x:Bind ViewModel.FromDate, Mode=TwoWay}"/>
                <CalendarDatePicker x:Uid="HistoryPage_CalendarDatePicker2" PlaceholderText="Added until" Date="{x:Bind ViewModel.ToDate, Mode=TwoWay}"/>
                <Button x:Uid="HistoryPage_Button1" Content="Clear filters" Click="ClearFilters_Click" Visibility="{x:Bind ViewModel.HasFilter, Mode=OneWay}"/>
            </StackPanel>
        </ScrollViewer>

        <InfoBar x:Uid="HistoryPage_InfoBar2" Grid.Row="4" IsOpen="{x:Bind ViewModel.HasActionMessage, Mode=OneWay}" Severity="Error" Title="That did not work"
                 Message="{x:Bind ViewModel.ActionMessage, Mode=OneWay}" CloseButtonClick="ActionMessage_Closed"/>

        <Grid Grid.Row="5">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="*" />
            </Grid.RowDefinitions>

            <Grid Padding="12,0,12,6" ColumnSpacing="12" Visibility="{x:Bind ViewModel.HasRows, Mode=OneWay}">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="110" />
                    <ColumnDefinition Width="90" />
                    <ColumnDefinition Width="150" />
                    <ColumnDefinition Width="150" />
                    <ColumnDefinition Width="220" />
                </Grid.ColumnDefinitions>
                <TextBlock x:Uid="HistoryPage_TextBlock1" Text="Name" Opacity="0.7"/>
                <TextBlock x:Uid="HistoryPage_TextBlock2" Grid.Column="1" Text="Status" Opacity="0.7"/>
                <TextBlock x:Uid="HistoryPage_TextBlock3" Grid.Column="2" Text="Size" Opacity="0.7"/>
                <TextBlock x:Uid="HistoryPage_TextBlock4" Grid.Column="3" Text="Added" Opacity="0.7"/>
                <TextBlock x:Uid="HistoryPage_TextBlock5" Grid.Column="4" Text="Finished" Opacity="0.7"/>
                <TextBlock x:Uid="HistoryPage_TextBlock6" Grid.Column="5" Text="Folder" Opacity="0.7"/>
            </Grid>

            <ListView x:Name="HistoryList" Grid.Row="1" ItemsSource="{x:Bind ViewModel.Rows}" SelectionMode="Extended"
                      Visibility="{x:Bind ViewModel.HasRows, Mode=OneWay}"
                      SelectionChanged="List_SelectionChanged" PreviewKeyDown="List_KeyDown" ContextRequested="List_ContextRequested"
                      DoubleTapped="List_DoubleTapped">
                <FlyoutBase.AttachedFlyout>
                    <MenuFlyout>
                        <MenuFlyoutItem x:Uid="HistoryPage_MenuFlyoutItem3" Text="Download again" Click="Redownload_Click" IsEnabled="{x:Bind ViewModel.CanRedownload, Mode=OneWay}">
                            <MenuFlyoutItem.Icon><FontIcon Glyph="&#xE72C;" /></MenuFlyoutItem.Icon>
                        </MenuFlyoutItem>
                        <MenuFlyoutItem x:Uid="HistoryPage_MenuFlyoutItem4" Text="Download to…" Click="DownloadTo_Click" IsEnabled="{x:Bind ViewModel.CanRedownload, Mode=OneWay}"/>
                        <MenuFlyoutSeparator />
                        <MenuFlyoutItem x:Uid="HistoryPage_MenuFlyoutItem5" Text="Open file" Click="OpenFile_Click" IsEnabled="{x:Bind ViewModel.CanOpenFile, Mode=OneWay}" KeyboardAcceleratorTextOverride="Enter">
                            <MenuFlyoutItem.Icon><FontIcon Glyph="&#xE8E5;" /></MenuFlyoutItem.Icon>
                        </MenuFlyoutItem>
                        <MenuFlyoutItem x:Uid="HistoryPage_MenuFlyoutItem6" Text="Open folder" Click="OpenFolder_Click" IsEnabled="{x:Bind ViewModel.CanOpenFolder, Mode=OneWay}">
                            <MenuFlyoutItem.Icon><FontIcon Glyph="&#xE838;" /></MenuFlyoutItem.Icon>
                        </MenuFlyoutItem>
                        <MenuFlyoutItem x:Uid="HistoryPage_MenuFlyoutItem7" Text="Copy URL" Click="CopyUrl_Click" IsEnabled="{x:Bind ViewModel.CanCopyUrl, Mode=OneWay}">
                            <MenuFlyoutItem.Icon><FontIcon Glyph="&#xE8C8;" /></MenuFlyoutItem.Icon>
                        </MenuFlyoutItem>
                        <MenuFlyoutSeparator />
                        <MenuFlyoutItem x:Uid="HistoryPage_MenuFlyoutItem8" Text="Remove from history" Click="Delete_Click" IsEnabled="{x:Bind ViewModel.CanDelete, Mode=OneWay}" KeyboardAcceleratorTextOverride="Del">
                            <MenuFlyoutItem.Icon><FontIcon Glyph="&#xE74D;" /></MenuFlyoutItem.Icon>
                        </MenuFlyoutItem>
                    </MenuFlyout>
                </FlyoutBase.AttachedFlyout>
                <ListView.ItemContainerStyle>
                    <Style TargetType="ListViewItem" BasedOn="{StaticResource DefaultListViewItemStyle}">
                        <Setter Property="HorizontalContentAlignment" Value="Stretch" />
                        <Setter Property="MinHeight" Value="44" />
                    </Style>
                </ListView.ItemContainerStyle>
                <ListView.ItemTemplate>
                    <DataTemplate x:DataType="vm:HistoryRowViewModel">
                        <Grid ColumnSpacing="12" AutomationProperties.Name="{x:Bind AccessibleName, Mode=OneWay}">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="110" />
                                <ColumnDefinition Width="90" />
                                <ColumnDefinition Width="150" />
                                <ColumnDefinition Width="150" />
                                <ColumnDefinition Width="220" />
                            </Grid.ColumnDefinitions>
                            <StackPanel VerticalAlignment="Center">
                                <TextBlock Text="{x:Bind Name}" TextTrimming="CharacterEllipsis" ToolTipService.ToolTip="{x:Bind Name}" />
                                <TextBlock Text="{x:Bind MissingText, Mode=OneWay}" Style="{StaticResource CaptionTextBlockStyle}"
                                           Foreground="{ThemeResource SystemFillColorCriticalBrush}" />
                            </StackPanel>
                            <TextBlock Grid.Column="1" Text="{x:Bind StatusText}" VerticalAlignment="Center" ToolTipService.ToolTip="{x:Bind StatusTip}" />
                            <TextBlock Grid.Column="2" Text="{x:Bind SizeText}" VerticalAlignment="Center" />
                            <TextBlock Grid.Column="3" Text="{x:Bind AddedText}" VerticalAlignment="Center" />
                            <TextBlock Grid.Column="4" Text="{x:Bind FinishedText}" VerticalAlignment="Center" />
                            <TextBlock Grid.Column="5" Text="{x:Bind Folder}" VerticalAlignment="Center" TextTrimming="CharacterEllipsis"
                                       ToolTipService.ToolTip="{x:Bind Folder}" />
                        </Grid>
                    </DataTemplate>
                </ListView.ItemTemplate>
            </ListView>

            <TextBlock x:Uid="HistoryPage_TextBlock7" Grid.RowSpan="2" HorizontalAlignment="Center" VerticalAlignment="Center" Opacity="0.7"
                       Text="Nothing matches these filters." Visibility="{x:Bind ViewModel.IsFilteredEmpty, Mode=OneWay}"/>

            <StackPanel Grid.RowSpan="2" HorizontalAlignment="Center" VerticalAlignment="Center" Spacing="10"
                        Visibility="{x:Bind ViewModel.IsHistoryEmpty, Mode=OneWay}">
                <FontIcon Glyph="&#xE81C;" FontSize="48" Opacity="0.6" />
                <TextBlock x:Uid="HistoryPage_TextBlock8" Text="No history yet" Style="{StaticResource SubtitleTextBlockStyle}" HorizontalAlignment="Center"/>
                <TextBlock x:Uid="HistoryPage_TextBlock9" Text="Downloads you add are recorded here and stay after you close the app." Opacity="0.7" HorizontalAlignment="Center"/>
            </StackPanel>
        </Grid>

        <TextBlock Grid.Row="6" Text="{x:Bind ViewModel.CountText, Mode=OneWay}" Opacity="0.8" />
    </Grid>
</Page>
