<?xml version="1.0" encoding="utf-8"?>
<ContentDialog
    x:Class="Aria2NET.Pages.SpeedLimitDialog"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    Title="Speed limit"
    PrimaryButtonText="Apply"
    CloseButtonText="Cancel"
    DefaultButton="Primary">

    <StackPanel Spacing="8" MinWidth="320">
        <Grid ColumnSpacing="8">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>
            <NumberBox x:Name="LimitBox" Header="Maximum speed" Minimum="0" SpinButtonPlacementMode="Inline" SmallChange="100" LargeChange="1000"
                       ValueChanged="LimitBox_ValueChanged" />
            <ComboBox x:Name="UnitBox" Grid.Column="1" VerticalAlignment="Bottom" SelectedIndex="0">
                <ComboBoxItem Content="KiB/s" />
                <ComboBoxItem Content="MiB/s" />
            </ComboBox>
        </Grid>
        <TextBlock Text="0 means no limit." Opacity="0.7" />
    </StackPanel>
</ContentDialog>
