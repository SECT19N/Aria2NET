<?xml version="1.0" encoding="utf-8"?>
<ContentDialog
    x:Class="Aria2NET.Pages.RenameDialog"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    Title="Rename download"
    PrimaryButtonText="Rename"
    CloseButtonText="Cancel"
    DefaultButton="Primary">

    <StackPanel Spacing="8" MinWidth="380">
        <TextBox x:Name="NameBox" Header="File name" TextChanged="NameBox_TextChanged" />
        <TextBlock x:Name="ErrorText" Foreground="{ThemeResource SystemFillColorCriticalBrush}" TextWrapping="Wrap" />
    </StackPanel>
</ContentDialog>
